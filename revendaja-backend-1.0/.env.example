# Ambiente da aplicação: development | test | production
NODE_ENV=development

# Servidor HTTP
PORT=3000
HOST=0.0.0.0

# Nível de log do Pino: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# String de conexão do PostgreSQL usada pelo Prisma
DATABASE_URL="postgresql://revendaja:revendaja@localhost:5432/revendaja?schema=public"

# Redis usado pela fila de notificações (BullMQ). Se cair em runtime, a API continua no ar
# servindo venda/estoque — só as notificações degradam até o Redis voltar.
REDIS_URL="redis://localhost:6379"

# Autenticação (JWT) — gere valores fortes em produção, ex: openssl rand -hex 32
JWT_SECRET="troque-este-valor-por-um-segredo-forte-em-producao"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="troque-este-valor-por-outro-segredo-forte-em-producao"
JWT_REFRESH_EXPIRES_IN="30d"

# Login com Google (POST /auth/google). Client ID tipo "Web application", criado no mesmo
# projeto do Google Cloud do google-services.json (ver revendaja-mobile-1.0). Sem isso, a rota
# responde 500 com uma mensagem clara — o resto da API sobe normalmente.
GOOGLE_CLIENT_ID=""

# Domínio base para o link público da loja: {esquema}://{handle}.STORE_BASE_DOMAIN
# Desenvolvimento: "localhost:3001" (link http://vianastore.localhost:3001). Produção: "revendaja.com".
STORE_BASE_DOMAIN="revendaja.com"
# Opcional. Sem ele: http para localhost e https para qualquer outro domínio.
# STORE_LINK_SCHEME="https"

# Atrás de um proxy/balanceador (nginx, Render, Railway...) o IP real do cliente vem em
# X-Forwarded-For: use true SÓ se houver um proxy confiável na frente (o limite de requisições das
# rotas públicas conta por IP). Sem proxy, deixe false.
TRUST_PROXY=false

# Horas até um pedido da vitrine que ninguém pagou ser cancelado sozinho (o estoque reservado volta)
ONLINE_ORDER_EXPIRATION_HOURS=48

# Dias que as visitas da vitrine ficam guardadas (mínimo 7: a tela Minha Loja usa os últimos 7 dias)
STORE_VISITS_RETENTION_DAYS=30

# E-mail transacional (Resend — https://resend.com/api-keys)
# Vazio em desenvolvimento: os e-mails não saem, o conteúdo (inclusive o código
# do OTP) é só logado no console. Obrigatória com NODE_ENV=production.
RESEND_API_KEY=
# Remetente. O padrão (onboarding@resend.dev) é o domínio de testes da Resend e só
# entrega para o e-mail dono da conta; para enviar a qualquer pessoa, verifique um
# domínio próprio na Resend e use algo como "Revendaja <nao-responda@seudominio.com>".
MAIL_FROM="Revendaja <onboarding@resend.dev>"

# Verificação de conta por código (OTP) — enviado por e-mail
OTP_EXPIRATION_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_RESEND_MAX_PER_HOUR=5

# Redefinição de senha ("esqueci minha senha") — código de 6 dígitos enviado por e-mail
PASSWORD_RESET_EXPIRATION_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_COOLDOWN_SECONDS=30
PASSWORD_RESET_MAX_PER_HOUR=5

# Upload de imagem de produto manual (S3). Vazias em desenvolvimento: a rota de upload responde
# 500 até serem preenchidas. Obrigatórias em produção.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
# URL pública base pra montar o link da imagem (sem barra no final), ex.:
# "https://meu-bucket.s3.us-east-1.amazonaws.com" ou o domínio de um CDN na frente do bucket.
S3_PUBLIC_BASE_URL=

# Push notifications (Expo). Opcional: só é exigido pelo Expo se a conta tiver
# "enhanced security" ativada — https://docs.expo.dev/push-notifications/sending-notifications/
EXPO_ACCESS_TOKEN=

# Notificações automáticas (BullMQ) — intervalos dos jobs recorrentes e limiares de negócio.
NOTIFICATION_STOCK_CHECK_INTERVAL_MINUTES=60
NOTIFICATION_GOAL_CHECK_INTERVAL_MINUTES=360
NOTIFICATION_PROMOTION_SCAN_INTERVAL_MINUTES=1440
# Cadência por loja da notificação promocional (não é a frequência do job — o job varre
# todo dia, cada loja só é notificada se já passou esse número de dias desde a última vez).
NOTIFICATION_PROMOTION_INTERVAL_DAYS=3
NOTIFICATION_GOAL_THRESHOLD_PERCENT=80

# Cobrança (Stripe — https://dashboard.stripe.com). Sem STRIPE_SECRET_KEY as rotas /billing
# respondem 503; o resto da API sobe normalmente. Prefira uma chave restrita (rk_...).
STRIPE_SECRET_KEY=
# Segredo do endpoint de webhook (whsec_...). Endpoint: POST {API}/billing/webhook. Em dev:
# `stripe listen --forward-to localhost:3000/billing/webhook` imprime esse segredo.
STRIPE_WEBHOOK_SECRET=
# Ids dos preços mensais recorrentes (price_...) de cada plano pago
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_BUSINESS=
# URL do painel web (retorno do Checkout e do portal de cobrança)
WEB_APP_URL="http://localhost:3001"
