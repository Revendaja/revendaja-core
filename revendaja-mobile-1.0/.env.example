# URL base da API do Revendaja. Copie este arquivo para .env.local e ajuste.
#
# - iOS Simulator / web:        http://localhost:3000
# - Emulador Android:           http://10.0.2.2:3000   (padrão quando a variável não é definida)
# - Aparelho físico (Expo Go):  http://<IP-da-sua-máquina-na-rede>:3000
#
# Variáveis EXPO_PUBLIC_* ficam visíveis no app compilado: nunca coloque segredos aqui.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Login com Google: Client ID tipo "Web application" do Google Cloud Console (mesmo projeto do
# google-services.json). NÃO é segredo — é o mesmo valor que o backend usa como GOOGLE_CLIENT_ID
# para validar o idToken. Sem ele, o botão "Continuar com Google" mostra um erro claro.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
