# local env files
.env*.local

# Firebase — a chave de admin (acesso total à API do projeto) nunca pode ir pro repositório.
# google-services.json / GoogleService-Info.plist NÃO entram aqui de propósito: o EAS Build só
# empacota arquivos rastreados pelo git, e esses dois precisam estar no build (não são segredo tipo
# senha — só identificam o app pro Firebase, protegidos por pacote/assinatura, não por sigilo).
*firebase-adminsdk*.json

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
